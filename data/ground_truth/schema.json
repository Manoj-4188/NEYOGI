{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neyogi.example.org/schemas/ground-truth-parcels.json",
  "title": "NEYOGI ground-truth parcel collection",
  "description": "Digitised field parcels with human-attributed crop labels. Coordinates must be EPSG:4326 (RFC 7946).",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/parcelFeature" }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/position" }
    },
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/linearRing" }
        }
      }
    },
    "multiPolygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/linearRing" }
          }
        }
      }
    },
    "parcelFeature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {
          "oneOf": [
            { "$ref": "#/$defs/polygon" },
            { "$ref": "#/$defs/multiPolygon" }
          ]
        },
        "properties": {
          "type": "object",
          "properties": {
            "parcel_uid": {
              "type": "string",
              "minLength": 1,
              "description": "Stable identifier from the source survey."
            },
            "district": {
              "type": "string",
              "minLength": 1,
              "description": "District name; resolved against FAO/GAUL/2015/level2 at query time."
            },
            "crop_label": {
              "type": "string",
              "description": "Must resolve to one of the five NEYOGI classes. Aliases are accepted; unknown values abort the load."
            },
            "verified_by": {
              "type": "string",
              "minLength": 1,
              "description": "Person or survey standing behind the label. Required for verified_flag to be set."
            },
            "survey_date": {
              "type": "string",
              "description": "Date the parcel was attributed in the field."
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
