# ---------------------------------------------------------------------------
# NEYOGI — environment template. Copy to .env and fill. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- PostGIS ---------------------------------------------------------------
POSTGRES_USER=neyogi
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=neyogi
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://neyogi:change-me-in-production@postgis:5432/neyogi

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Google Earth Engine ---------------------------------------------------
# Service-account auth is required for headless/containerised runs.
# Create at https://console.cloud.google.com and register it at
# https://signup.earthengine.google.com/#!/service_accounts
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/gee_service_account.json
GEE_PROJECT_ID=

# --- AGMARKNET (data.gov.in Open Government Data platform) -----------------
# Register at https://data.gov.in to obtain an API key.
AGMARKNET_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_BASE_URL=https://api.data.gov.in/resource
AGMARKNET_STATE=Karnataka
AGMARKNET_TIMEOUT_SECONDS=12

# --- Twilio WhatsApp -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true
PUBLIC_BASE_URL=https://neyogi.example.org

# --- Auth / role gating ----------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=480
# Seed officer accounts as "username:bcrypt_hash" pairs, comma separated.
# Generate a hash with: python -m backend.security hash <password>
#
# IMPORTANT: escape every '$' in the hash as '$$'. Docker Compose performs
# variable substitution on this file, so an unescaped "$2b$12$Abc..."
# has "$2b", "$12" and "$Abc..." read as variable names and replaced with
# empty strings, leaving a truncated hash that can never verify.
#   correct:  OFFICER_ACCOUNTS=pavan:$$2b$$12$$Kix8n....
#   wrong:    OFFICER_ACCOUNTS=pavan:$2b$12$Kix8n....
OFFICER_ACCOUNTS=

# --- Data freshness policy (drives the UI status badges) -------------------
SATELLITE_CACHE_MAX_AGE_DAYS=30
MARKET_CACHE_MAX_AGE_DAYS=30
GEE_SEED_LOOKBACK_DAYS=60
COMPOSITE_PERIOD_DAYS=16

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
